GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Reasoning effort for models that support it. Use "none" for models that reject the option.
LLM_REASONING_EFFORT=low
SUPABASE_URL=
# Leave empty unless the Supabase project still signs tokens with the legacy JWT secret (HS256).
SUPABASE_JWT_SECRET=
FRONTEND_URL=http://localhost:3000
# Per-user rate limits
RATE_LIMIT_LLM=30/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_TUTOR=20/minute
# Voice tutor: "local" (falls back to cloud if the local model cannot load) or "cloud"
VOICE_STT_PROVIDER=local
VOICE_TTS_PROVIDER=local
# Order of server voices: kokoro, groq, edge. "browser" ends the list. Empty means kokoro,groq when VOICE_TTS_PROVIDER=local, otherwise groq.
VOICE_TTS_ORDER=
# Kokoro's Hindi voice, used for Hinglish only when kokoro is in the order
VOICE_TTS_HINDI_VOICE=hf_alpha
# Optional voice settings; the defaults are shown
VOICE_STT_MODEL=base
VOICE_STT_CLOUD_MODEL=whisper-large-v3-turbo
VOICE_TTS_VOICE=af_heart
VOICE_TTS_MODEL_FILE=kokoro-v1.0.int8.onnx
# Cloud voice: Groq text-to-speech (uses GROQ_API_KEY). Voices: autumn, diana, hannah, austin, daniel, troy
VOICE_TTS_CLOUD_MODEL=canopylabs/orpheus-v1-english
VOICE_TTS_CLOUD_VOICE=hannah
# Last cloud fallback (edge-tts)
VOICE_TTS_EDGE_VOICE=en-IN-NeerjaNeural
# Load speech models at server start (1) or on the first tutor question (0)
VOICE_WARMUP=1
# Where speech models are cached; defaults to ~/.cache/prepwise/voice
VOICE_MODEL_DIR=
# YouTube Data API v3 key for the tutor's "More videos" list. Optional: leave empty to show only hand-picked videos.
YOUTUBE_API_KEY=
