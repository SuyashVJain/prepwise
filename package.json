{
  "name": "prepwise",
  "version": "1.0.0",
  "private": true,
  "description": "Mock interviews that fact-check every answer claim by claim, grounded in your own syllabus.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuyashVJain/prepwise.git"
  },
  "homepage": "https://github.com/SuyashVJain/prepwise#readme",
  "bugs": {
    "url": "https://github.com/SuyashVJain/prepwise/issues"
  },
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "cd frontend && npx tsc --noEmit",
    "build": "npm --prefix frontend run build",
    "test": "cd backend && python -m unittest discover -s tests -t . && python -m tests.score_comparison --offline"
  }
}
